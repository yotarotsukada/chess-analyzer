{
  "name": "chess-analyzer",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "tsx server/worker/main.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "openings:build": "tsx scripts/build-openings.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.2.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
